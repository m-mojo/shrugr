# TMDB API Read Access Token. Keep the real value in .env.local and Vercel server-side environment variables.
TMDB_API_READ_ACCESS_TOKEN=

# Supabase project URL and publishable/anon key. Never put a service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key from Supabase Project Settings → API Keys → Secret keys, for the local catalog sync script.
# Never prefix with NEXT_PUBLIC_ or expose it in client code.
SUPABASE_SECRET_KEY=
